# 家庭智能终端 - 配置模板
# 使用方法：复制本文件为 .env，填入你自己的值
# 注意：.env 已被 .gitignore 排除，密钥不会上传 GitHub

# ---- LLM 服务（OpenAI 兼容接口，必填）----
# 本地示例：LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 思考模式：值原样传给网关，各家枚举不同
#   commandcode: off（关闭，语音场景必填）/ low / medium / high / xhigh / max
#   aisp:        none（关闭）/ low / medium / high
# 留空表示不传这个参数；网关不认它时留空，改用下面的 LLM_CHAT_TEMPLATE_KWARGS
LLM_REASONING_EFFORT=off
# 可选：访问网关走本机代理（如 Clash/V2Ray 的 mixed 端口）。留空 = 不干预。
# 直连很慢时配它：设了 NO_PROXY 的机器上 requests 会跳过系统代理，变成裸连远端。
LLM_PROXY=
# 看一眼之后，「刚才看到什么」在会话里保留多少秒（只在内存，不进记忆库）
VISION_CONTEXT_SECONDS=180

# ---- TTS 语音（可选，有默认值）----
# 女声: zh-CN-XiaoxiaoNeural   男声: zh-CN-YunxiNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---- STT 语音识别（可选，有默认值）----
# 只想用文字聊天就设 0：跳过 FunASR 模型（首跑约 900MB），/api/voice 返回 503
STT_ENABLED=1
STT_MODEL=iic/SenseVoiceSmall
STT_LANGUAGE=zh

# ---- 记忆存储（可选）----
MEMORY_DB_PATH=./data/memory.db
ITEMS_DB_PATH=./data/items.db
AGENT_DB_PATH=./data/agent.db
TASKS_DB_PATH=./data/tasks.db
FACTS_DB_PATH=./data/facts.db
PENDING_ACTION_TTL_SECONDS=1800
PROPOSAL_DEDUPE_SECONDS=300
# 弱模型模式：0 关闭 / 1 所有写操作先确认 / tasks 只确认任务；本地小模型建议 1 或 tasks
CONFIRM_WRITE_ACTIONS=0

# ---- 音频录制（可选）----
SAMPLE_RATE=16000
CHUNK_SIZE=1024
MAX_RECORD_SECONDS=15
SILENCE_THRESHOLD=0.015
SILENCE_DURATION=1.2

# ---- Web 服务端 ----
# 局域网访问可改为 0.0.0.0，并务必设置 API_TOKEN
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
API_TOKEN=
# MCP 接入点（小智设备端出站连接）：留空不启用；非空时设备用 ?token= 鉴权
MCP_TOKEN=
MAX_TEXT_CHARS=2000
MAX_CLIENT_ID_CHARS=128
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=30
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=1000

# ---- 唤醒词（CLI 常驻监听：python main.py wake）----
WAKE_WORD=小马
WAKE_WORD_MAX_SECONDS=8
WAKE_ACK_TEXT=我在

# ---- 多轮对话上下文 ----
# 注入 agent 的最近对话轮数（0=关闭多轮上下文）；单条历史截断字数
SESSION_CONTEXT_TURNS=5
SESSION_CONTEXT_MAX_CHARS=300

# ---- 到期提醒 ----
# 未来几天内算"即将到期"；后台扫描间隔（秒）；同一物品再次提醒的冷却（小时，0=只提醒一次）
REMINDER_DAYS=3
REMINDER_INTERVAL_SECONDS=60
REMINDER_COOLDOWN_HOURS=24

# ---- Web Push（页面关闭时的系统通知，可选）----
# 用 python scripts/gen_vapid.py 生成后粘到这里，然后重启服务端
PUSH_ENABLED=0
PUSH_DB_PATH=./data/push.db
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
PUSH_TTL_SECONDS=43200
PUSH_MAX_FAILURES=5
LLM_CHAT_TEMPLATE_KWARGS=

# ---- 智能家居（Home Assistant 当设备网关，可选）----
# HA 里装小米官方集成（Xiaomi Home）；小马只跟 HA 的本地 REST 说话。
# HOME_TOKEN：HA「个人资料 → 安全 → 长期访问令牌」生成。留空则不注册设备工具。
HOME_BASE_URL=http://127.0.0.1:8123
HOME_TOKEN=
HOME_TIMEOUT_SECONDS=5
# 小马认识哪些设备：逗号分隔，可写 `entity_id=别名`。MIoT 会把每个属性都变成
# 一个实体（一台空调 60 多个），不做白名单根本没法读。别名就是小马念出来的名字。
HOME_DEVICES=
# 允许语音直接控制的设备：逗号分隔 entity_id，或 `light.` 这样的域前缀。
# 留空 = 全部只读（当前阶段就应该是空的，先把「读」跑顺）。
HOME_CONTROL_ALLOW=
# 主动提醒：滤芯余量跌破此百分比就提醒（设很大等于关闭）；同一设备多少小时内不重复
HOME_FILTER_ALERT_PERCENT=10
HOME_ALERT_COOLDOWN_HOURS=24
# 盯哪些 event 实体（逗号分隔），如摄像头的「有人出现了」。留空 = 不盯：
# 移动侦测按小时触发，默认开会把客厅变成刷屏机器。
HOME_WATCH_EVENTS=
HOME_EVENT_COOLDOWN_SECONDS=600
HOME_SCAN_SECONDS=15
