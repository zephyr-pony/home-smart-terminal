# 家庭智能终端 - 配置模板
# 使用方法：复制为 .env，至少填「最小配置」三项；其余都有默认值。
# 注意：.env 已被 .gitignore 排除，密钥不会上传 GitHub。
#
# 改完可以先自检，不用等启动：
#   python scripts/doctor.py

# ==================== 最小配置（必填） ====================
# OpenAI 兼容接口；本地 llama.cpp / LM Studio / OneAPI 网关都行
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ==================== 常用（想改再动） ====================
# 局域网访问改成 0.0.0.0 时，必须同时设置 API_TOKEN，否则服务端拒绝启动
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
API_TOKEN=

# 所有数据库、备份默认都在这个目录下
DATA_DIR=./data

# 女声: zh-CN-XiaoxiaoNeural   男声: zh-CN-YunxiNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 只想用文字聊天就设 0：跳过 FunASR 模型（首跑约 900MB），/api/voice 返回 503
STT_ENABLED=1

# 未来几天内算「即将到期」；后台扫描间隔（秒）；同一物品再次提醒的冷却（小时，0=只提醒一次）
REMINDER_DAYS=3
REMINDER_INTERVAL_SECONDS=60
REMINDER_COOLDOWN_HOURS=24

# 弱模型模式：0 关闭 / 1 所有写操作先确认 / tasks 只确认任务；本地小模型建议 1 或 tasks
CONFIRM_WRITE_ACTIONS=0

# ==================== 可选模块（默认关闭） ====================
# ---- 小智设备接入（MCP）----
# 留空不启用；非空时设备用 ?token= 鉴权。日志里的 token 已自动打码。
MCP_TOKEN=

# ---- Web Push（页面关闭时的系统通知）----
# 用 python scripts/gen_vapid.py 生成后粘到这里，然后重启服务端
PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
PUSH_TTL_SECONDS=43200
PUSH_MAX_FAILURES=5

# ---- 智能家居（Home Assistant 当设备网关）----
# HA 里装小米官方集成（Xiaomi Home）；小马只跟 HA 的本地 REST 说话。
# HOME_TOKEN：HA「个人资料 → 安全 → 长期访问令牌」生成。留空则不注册设备工具。
HOME_BASE_URL=http://127.0.0.1:8123
HOME_TOKEN=
HOME_TIMEOUT_SECONDS=5
# 小马认识哪些设备：逗号分隔，可写 `entity_id=别名`。MIoT 会把每个属性都变成
# 一个实体（一台空调 60 多个），不做白名单根本没法读。别名就是小马念出来的名字。
HOME_DEVICES=
# 允许语音直接控制的设备：逗号分隔 entity_id，或 `light.` 这样的域前缀。
# 留空 = 全部只读（当前阶段就应该是空的，先把「读」跑顺）。
HOME_CONTROL_ALLOW=
# 主动提醒：滤芯余量跌破此百分比就提醒（设很大等于关闭）；同一设备多少小时内不重复
HOME_FILTER_ALERT_PERCENT=10
HOME_ALERT_COOLDOWN_HOURS=24
# 盯哪些 event 实体（逗号分隔），如摄像头的「有人出现了」。留空 = 不盯：
# 移动侦测按小时触发，默认开会把客厅变成刷屏机器。
HOME_WATCH_EVENTS=
HOME_EVENT_COOLDOWN_SECONDS=600
HOME_SCAN_SECONDS=15

# ---- 天气 ----
# 默认走 Open-Meteo，不需要注册任何 key：只填 WEATHER_CITY 就能用。
# 配了和风的 Host+Key 则优先用和风（中国局地数据更准）。
WEATHER_CITY=
# 可选：填了经纬度就跳过城市名匹配。Open-Meteo 的 geocoding 偶尔撞上同名小地方
# （搜「烟台」会命中辽宁的小村），填坐标最稳。
WEATHER_LAT=
WEATHER_LON=
# 可选：和风天气（qweather.com）。Host 是控制台「项目管理」里的专属域名，
# 形如 abc123.re.qweatherapi.com，必须和 Key 配对；两项都填才启用。
WEATHER_API_HOST=
WEATHER_API_KEY=

# ---- 热点上下文（D58）----
# 会话开始时把「用户画像 + 常用事实 + 最近记忆」注入 system prompt，会话内冻结。
# 目的是省掉「查一次记忆」那一轮 LLM（语音场景 2-5 秒）；预算必须小，装热点不装长尾。
HOT_CONTEXT_ENABLED=1
# 总字符预算；超了按 画像 > 常用事实 > 最近记忆 的顺序截断
HOT_CONTEXT_MAX_CHARS=900
# 常用事实最多几条
HOT_CONTEXT_FACTS=6
# 最近记忆最多几条
HOT_CONTEXT_MEMORIES=5

# ---- 记忆蒸馏（D60）----
# 合并同主题记忆，只重算摘要、不删原文。每天深夜跑一次，或超过阈值时补跑。
MEMORY_DISTILL_ENABLED=1
# 深夜几点开始（本机时间，0-23）
MEMORY_DISTILL_HOUR=3
# 记忆达到多少条时不等半夜、直接补跑一次
MEMORY_DISTILL_THRESHOLD=500
# 超阈值补跑的间隔（小时），避免一直占着模型
MEMORY_DISTILL_INTERVAL_HOURS=6
# 每轮最多合并几组（一组一次模型调用，别一次把额度跑完）
MEMORY_DISTILL_MAX_GROUPS=10
# 合并后的摘要最多多少字
MEMORY_DISTILL_SUMMARY_CHARS=60

# ==================== 高级（一般不用动） ====================
# ---- LLM 细节 ----
# 第一轮（决策/挑工具）可以换更快的小模型；留空 = 两轮都用 LLM_MODEL
LLM_MODEL_DECISION=
# 思考模式：值原样传给网关，各家枚举不同
#   commandcode: off（关闭，语音场景必填）/ low / medium / high / xhigh / max
#   aisp:        none（关闭）/ low / medium / high
# 留空表示不传这个参数；网关不认它时留空。
LLM_REASONING_EFFORT=off
# 本地 llama.cpp/vLLM 关思考用，JSON，如 {"enable_thinking": false}
LLM_CHAT_TEMPLATE_KWARGS=
# 访问网关走本机代理（如 Clash/V2Ray 的 mixed 端口）。留空 = 不干预。
LLM_PROXY=
# 拍照后「刚才看到什么」在会话里保留多少秒（只在内存，不进记忆库）
VISION_CONTEXT_SECONDS=180

# ---- 语音识别细节 ----
STT_MODEL=iic/SenseVoiceSmall
STT_LANGUAGE=zh

# ---- 多轮对话与请求上限 ----
# 注入 agent 的最近对话轮数（0=关闭多轮上下文）；单条历史截断字数
SESSION_CONTEXT_TURNS=5
SESSION_CONTEXT_MAX_CHARS=300
MAX_TEXT_CHARS=2000
MAX_CLIENT_ID_CHARS=128
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=30
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=1000

# ---- 澄清与提案 ----
PENDING_ACTION_TTL_SECONDS=1800
PROPOSAL_DEDUPE_SECONDS=300

# ---- 数据库路径（默认都在 DATA_DIR 下，迁移/测试才单独改）----
# MEMORY_DB_PATH=./data/memory.db
# ITEMS_DB_PATH=./data/items.db
# AGENT_DB_PATH=./data/agent.db
# TASKS_DB_PATH=./data/tasks.db
# FACTS_DB_PATH=./data/facts.db
# PUSH_DB_PATH=./data/push.db

# ---- 唤醒词（CLI 常驻监听：python main.py wake）----
WAKE_WORD=小马
WAKE_WORD_MAX_SECONDS=8
WAKE_ACK_TEXT=我在

# ---- 音频录制（CLI 用）----
SAMPLE_RATE=16000
CHUNK_SIZE=1024
MAX_RECORD_SECONDS=15
SILENCE_THRESHOLD=0.015
SILENCE_DURATION=1.2
