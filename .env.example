# 家庭智能终端 - 配置模板
# 使用方法：复制本文件为 .env，填入你自己的值
# 注意：.env 已被 .gitignore 排除，密钥不会上传 GitHub

# ---- LLM 服务（OpenAI 兼容接口，必填）----
# 本地示例：LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- TTS 语音（可选，有默认值）----
# 女声: zh-CN-XiaoxiaoNeural   男声: zh-CN-YunxiNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---- STT 语音识别（可选，有默认值）----
STT_MODEL=iic/SenseVoiceSmall
STT_LANGUAGE=zh

# ---- 记忆存储（可选）----
MEMORY_DB_PATH=./data/memory.db

# ---- 音频录制（可选）----
SAMPLE_RATE=16000
CHUNK_SIZE=1024
MAX_RECORD_SECONDS=15
SILENCE_THRESHOLD=0.015
SILENCE_DURATION=1.2

# ---- Web 服务端（阶段 2，可选）----
# 0.0.0.0 允许局域网设备访问；手机/平板用 http://<电脑IP>:8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=30
