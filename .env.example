# 家庭智能终端 - 配置模板
# 使用方法：复制本文件为 .env，填入你自己的值
# 注意：.env 已被 .gitignore 排除，密钥不会上传 GitHub

# ---- LLM 服务（OpenAI 兼容接口，必填）----
# 本地示例：LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- TTS 语音（可选，有默认值）----
# 女声: zh-CN-XiaoxiaoNeural   男声: zh-CN-YunxiNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ---- STT 语音识别（可选，有默认值）----
STT_MODEL=iic/SenseVoiceSmall
STT_LANGUAGE=zh

# ---- 记忆存储（可选）----
MEMORY_DB_PATH=./data/memory.db
ITEMS_DB_PATH=./data/items.db

# ---- 音频录制（可选）----
SAMPLE_RATE=16000
CHUNK_SIZE=1024
MAX_RECORD_SECONDS=15
SILENCE_THRESHOLD=0.015
SILENCE_DURATION=1.2

# ---- Web 服务端 ----
# 局域网访问可改为 0.0.0.0，并务必设置 API_TOKEN
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
API_TOKEN=
MAX_TEXT_CHARS=2000
MAX_CLIENT_ID_CHARS=128
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_SECONDS=30
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=1000
