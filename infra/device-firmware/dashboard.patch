+void LcdDisplay::SetStandbyInfo(const StandbyInfo& info) {
+    if (!setup_ui_called_ || standby_box_ == nullptr) {
+        return;
+    }
+    auto apply = [](lv_obj_t* label, const std::string& text) {
+        if (label == nullptr) {
+            return;
+        }
+        if (text.empty()) {
+            // 这一行没有数据就不显示，别留空行、也别编一个值
+            lv_obj_add_flag(label, LV_OBJ_FLAG_HIDDEN);
+            return;
+        }
+        lv_obj_remove_flag(label, LV_OBJ_FLAG_HIDDEN);
+        lv_label_set_text(label, text.c_str());
+    };
+    DisplayLockGuard lock(this);
+    apply(standby_lunar_, info.lunar);
+    apply(standby_weather_, info.weather);
+    apply(standby_weather_note_, info.weather_note);
+    apply(standby_count_, info.count);
+    for (int i = 0; i < 2; ++i) {
+        const bool has = static_cast<size_t>(i) < info.items.size();
+        apply(standby_task_[i], has ? info.items[i].title : std::string());
+        apply(standby_when_[i], has ? info.items[i].when : std::string());
+    }
+}
+
+void LcdDisplay::UpdateStandbyClock() {
+    if (!standby_visible_.load() || standby_time_ == nullptr) {
+        return;
+    }
+    time_t now = time(nullptr);
+    struct tm tm_now;
+    localtime_r(&now, &tm_now);
+    if (tm_now.tm_year + 1900 < 2025) {
+        // OTA 还没给时间：显示占位符，别把 1970 当成真的
+        DisplayLockGuard lock(this);
+        lv_label_set_text(standby_time_, "--:--");
+        if (standby_date_ != nullptr) {
+            lv_label_set_text(standby_date_, "");
+        }
+        return;
+    }
+    int minute = tm_now.tm_hour * 60 + tm_now.tm_min;
+    if (minute == standby_clock_min_) {
+        return;
+    }
+    standby_clock_min_ = minute;
+
+    char time_str[8];
+    char date_str[32];
+    strftime(time_str, sizeof(time_str), "%H:%M", &tm_now);
+    static const char* weekdays[] = {"周日", "周一", "周二", "周三",
+                                     "周四", "周五", "周六"};
+    snprintf(date_str, sizeof(date_str), "%d月%d日 %s", tm_now.tm_mon + 1, tm_now.tm_mday,
+             weekdays[tm_now.tm_wday]);
+    DisplayLockGuard lock(this);
+    lv_label_set_text(standby_time_, time_str);
+    if (standby_date_ != nullptr) {
+        lv_label_set_text(standby_date_, date_str);
+    }
+}
+
+void LcdDisplay::UpdateStatusBar(bool update_all) {
+    LvglDisplay::UpdateStatusBar(update_all);
+    UpdateStandbyClock();
+}
