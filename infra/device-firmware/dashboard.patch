diff --git b/main/xiaoma_dashboard.cc b/main/xiaoma_dashboard.cc
new file mode 100644
index 0000000..9a06965
--- /dev/null
+++ b/main/xiaoma_dashboard.cc
@@ -0,0 +1,213 @@
+#include "xiaoma_dashboard.h"
+
+#include <cJSON.h>
+#include <esp_err.h>
+#include <esp_http_client.h>
+#include <esp_log.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <freertos/task.h>
+
+#include <cstdio>
+#include <string>
+
+#include "board.h"
+#include "display.h"
+
+namespace {
+
+constexpr const char* TAG = "XmDashboard";
+constexpr int kRefreshSeconds = 300;
+constexpr int kRetrySeconds = 60;
+constexpr int kMaxBody = 8192;
+
+SemaphoreHandle_t refresh_sem = nullptr;
+
+std::string NumberText(cJSON* item) {
+    if (!cJSON_IsNumber(item)) {
+        return "";
+    }
+    char buffer[16];
+    double value = item->valuedouble;
+    if (value == static_cast<int>(value)) {
+        snprintf(buffer, sizeof(buffer), "%d", static_cast<int>(value));
+    } else {
+        snprintf(buffer, sizeof(buffer), "%.1f", value);
+    }
+    return buffer;
+}
+
+std::string HttpGet() {
+    esp_http_client_config_t config = {};
+    config.url = CONFIG_XIAOMA_DASHBOARD_URL;
+    config.timeout_ms = 6000;
+    config.disable_auto_redirect = true;
+
+    esp_http_client_handle_t client = esp_http_client_init(&config);
+    if (client == nullptr) {
+        ESP_LOGW(TAG, "HTTP client init failed");
+        return "";
+    }
+    if (CONFIG_XIAOMA_DASHBOARD_TOKEN[0] != '\0') {
+        esp_http_client_set_header(client, "X-Display-Token",
+                                   CONFIG_XIAOMA_DASHBOARD_TOKEN);
+    }
+
+    std::string body;
+    esp_err_t err = esp_http_client_open(client, 0);
+    if (err != ESP_OK) {
+        ESP_LOGW(TAG, "open failed: %s", esp_err_to_name(err));
+        esp_http_client_cleanup(client);
+        return "";
+    }
+    // 必须先收完响应头，get_status_code() 才有值；之前先读状态码拿到的是 0。
+    int content_length = esp_http_client_fetch_headers(client);
+    int status = esp_http_client_get_status_code(client);
+    if (status == 200) {
+        char buffer[256];
+        int read = 0;
+        while ((read = esp_http_client_read(client, buffer, sizeof(buffer))) > 0) {
+            body.append(buffer, read);
+            if (body.size() >= kMaxBody) {
+                break;
+            }
+        }
+        if (body.empty() && content_length == 0) {
+            ESP_LOGW(TAG, "empty body");
+        }
+    } else {
+        ESP_LOGW(TAG, "HTTP %d", status);
+    }
+    esp_http_client_close(client);
+    esp_http_client_cleanup(client);
+    return body;
+}
+
+void ApplyBody(const std::string& body) {
+    cJSON* root = cJSON_Parse(body.c_str());
+    if (root == nullptr) {
+        ESP_LOGW(TAG, "invalid JSON");
+        return;
+    }
+
+    StandbyInfo info;
+    cJSON* lunar = cJSON_GetObjectItem(root, "lunar");
+    if (cJSON_IsString(lunar) && lunar->valuestring != nullptr) {
+        info.lunar = lunar->valuestring;
+    }
+
+    std::string weather_line;
+    std::string weather_note;
+    cJSON* weather = cJSON_GetObjectItem(root, "weather");
+    if (cJSON_IsObject(weather) && cJSON_IsTrue(cJSON_GetObjectItem(weather, "ok"))) {
+        cJSON* sky = cJSON_GetObjectItem(weather, "sky");
+        if (cJSON_IsString(sky) && sky->valuestring != nullptr) {
+            weather_line += sky->valuestring;
+        }
+        std::string temp = NumberText(cJSON_GetObjectItem(weather, "temp"));
+        if (!temp.empty()) {
+            if (!weather_line.empty()) {
+                weather_line += " ";
+            }
+            weather_line += temp + "℃";
+        }
+        std::string feels = NumberText(cJSON_GetObjectItem(weather, "feels"));
+        if (!feels.empty()) {
+            weather_line += " · 体感 " + feels + "°";
+        }
+        // 第二行：风 + 今天的高低温。缺哪个就少哪段，不补「--」
+        cJSON* wind = cJSON_GetObjectItem(weather, "wind");
+        if (cJSON_IsString(wind) && wind->valuestring != nullptr && wind->valuestring[0] != '\0') {
+            weather_note += wind->valuestring;
+        }
+        std::string high = NumberText(cJSON_GetObjectItem(weather, "high"));
+        std::string low = NumberText(cJSON_GetObjectItem(weather, "low"));
+        if (!high.empty() && !low.empty()) {
+            if (!weather_note.empty()) {
+                weather_note += " · ";
+            }
+            weather_note += high + "° / " + low + "°";
+        }
+    }
+    info.weather = weather_line;
+    info.weather_note = weather_note;
+
+    cJSON* today = cJSON_GetObjectItem(root, "today");
+    if (cJSON_IsObject(today)) {
+        cJSON* count = cJSON_GetObjectItem(today, "count");
+        const int total = cJSON_IsNumber(count) ? count->valueint : 0;
+        cJSON* items = cJSON_GetObjectItem(today, "items");
+        if (cJSON_IsArray(items)) {
+            const int n = cJSON_GetArraySize(items);
+            for (int i = 0; i < n && static_cast<int>(info.items.size()) < 2; ++i) {
+                cJSON* row = cJSON_GetArrayItem(items, i);
+                if (!cJSON_IsObject(row)) {
+                    continue;
+                }
+                StandbyItem item;
+                cJSON* title = cJSON_GetObjectItem(row, "title");
+                if (cJSON_IsString(title) && title->valuestring != nullptr) {
+                    item.title = title->valuestring;
+                }
+                cJSON* when = cJSON_GetObjectItem(row, "when");
+                if (cJSON_IsString(when) && when->valuestring != nullptr) {
+                    item.when = when->valuestring;
+                }
+                info.items.push_back(item);
+            }
+        }
+        if (total == 0) {
+            info.items.clear();
+            info.items.push_back(StandbyItem{"今天没事", ""});
+        } else if (total > 2) {
+            info.count = "还有 " + std::to_string(total - 2) + " 件";
+        }
+    }
+
+    auto display = Board::GetInstance().GetDisplay();
+    if (display != nullptr) {
+        display->SetStandbyInfo(info);
+    }
+    cJSON_Delete(root);
+}
+
+void DashboardTask(void*) {
+    // 等 Wi-Fi 连上、OTA 把时间校准，再拉第一轮
+    vTaskDelay(pdMS_TO_TICKS(8000));
+    for (;;) {
+        std::string body = HttpGet();
+        if (!body.empty()) {
+            ApplyBody(body);
+        }
+        TickType_t wait = pdMS_TO_TICKS(
+            (body.empty() ? kRetrySeconds : kRefreshSeconds) * 1000);
+        xSemaphoreTake(refresh_sem, wait);
+    }
+}
+
+}  // namespace
+
+void XmDashboardStart() {
+    if (CONFIG_XIAOMA_DASHBOARD_URL[0] == '\0') {
+        ESP_LOGI(TAG, "未配置 dashboard URL，待机看板不启用");
+        return;
+    }
+    if (refresh_sem != nullptr) {
+        return;
+    }
+    refresh_sem = xSemaphoreCreateBinary();
+    if (refresh_sem == nullptr) {
+        ESP_LOGE(TAG, "create semaphore failed");
+        return;
+    }
+    xTaskCreate(DashboardTask, "xm_dashboard", 8192, nullptr, 2, nullptr);
+    ESP_LOGI(TAG, "待机看板已启动：%s", CONFIG_XIAOMA_DASHBOARD_URL);
+}
+
+bool XmDashboardEnabled() { return CONFIG_XIAOMA_DASHBOARD_URL[0] != '\0'; }
+
+void XmDashboardRequestRefresh() {
+    if (refresh_sem != nullptr) {
+        xSemaphoreGive(refresh_sem);
+    }
+}
diff --git b/main/xiaoma_dashboard.h b/main/xiaoma_dashboard.h
new file mode 100644
index 0000000..c0767be
--- /dev/null
+++ b/main/xiaoma_dashboard.h
@@ -0,0 +1,19 @@
+#pragma once
+
+// 小马待机看板（D85）：待机时显示时间/日期/天气/今天最急的一件事。
+//
+// 数据来自服务端只读接口 `GET /api/display`（请求头 X-Display-Token）。
+// 地址和令牌在 menuconfig 的「Xiaoma Dashboard」里填；URL 留空时整个功能
+// 不启动，固件行为和上游完全一致。
+//
+// 为什么由设备主动拉：设备只跟小智语音服务端有一条 WebSocket，那条协议
+// 只送 TTS/会话指令；为了几行字去扩协议不划算，HTTP 拉一次 5 分钟更简单。
+
+// 启动后台拉取任务（可重复调用，只启动一次）。
+void XmDashboardStart();
+
+// 功能是否启用（menuconfig 里 URL 非空）。没启用时待机仍走上游的表情界面。
+bool XmDashboardEnabled();
+
+// 请求立即刷新一次（比如从对话回到待机时），失败会在下一轮自动重试。
+void XmDashboardRequestRefresh();
