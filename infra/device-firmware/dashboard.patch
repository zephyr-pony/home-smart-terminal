+// ---- 小马待机看板（D85） ----
+
+void LcdDisplay::SetStatus(const char* status) {
+    if (standby_visible_.load()) {
+        // 看板自己显示时间；状态栏再写一句「09:58」，屏幕上就有两个时间。
+        // 文字先存着，退出看板时补到状态栏（见 SetStandbyDashboard）。
+        standby_pending_status_ = (status != nullptr) ? status : "";
+        return;
+    }
+    ESP_LOGI(TAG, "SetStatus(%s) standby=0", status != nullptr ? status : "");
+    LvglDisplay::SetStatus(status);
+}
+
+void LcdDisplay::SetStandbyDashboard(bool visible) {
+    if (!setup_ui_called_ || standby_box_ == nullptr) {
+        ESP_LOGW(TAG, "standby dashboard skipped: setup=%d box=%p",
+                 static_cast<int>(setup_ui_called_), static_cast<void*>(standby_box_));
+        return;
+    }
+    {
+        DisplayLockGuard lock(this);
+        standby_visible_.store(visible);
+        auto lvgl_theme = static_cast<LvglTheme*>(current_theme_);
+        if (visible) {
+            // 顶部那条图标区也要变暖，不然看板下面米色、上面白，看着像没画完
+            if (lvgl_theme != nullptr) {
+                lv_obj_set_style_bg_color(lv_screen_active(), lv_color_hex(kStandbyBg), 0);
+                if (container_ != nullptr) {
+                    lv_obj_set_style_bg_color(container_, lv_color_hex(kStandbyBg), 0);
+                }
+            }
+            // 状态栏整条藏掉（只藏 label 在真机上会留残影），再用米色条盖住那块，
+            // 最后把图标条提到最上层，Wi-Fi/电量照常可见
+            if (status_bar_ != nullptr) {
+                lv_obj_add_flag(status_bar_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (status_label_ != nullptr) {
+                lv_obj_add_flag(status_label_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (standby_top_ != nullptr) {
+                lv_obj_remove_flag(standby_top_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (top_bar_ != nullptr) {
+                lv_obj_set_style_bg_opa(top_bar_, LV_OPA_TRANSP, 0);
+                lv_obj_move_foreground(top_bar_);
+            }
+            lv_obj_remove_flag(standby_box_, LV_OBJ_FLAG_HIDDEN);
+            if (emoji_box_ != nullptr && preview_image_cached_ == nullptr) {
+                lv_obj_add_flag(emoji_box_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (bottom_bar_ != nullptr) {
+                lv_obj_add_flag(bottom_bar_, LV_OBJ_FLAG_HIDDEN);
+            }
+        } else {
+            lv_obj_add_flag(standby_box_, LV_OBJ_FLAG_HIDDEN);
+            if (standby_top_ != nullptr) {
+                lv_obj_add_flag(standby_top_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (top_bar_ != nullptr) {
+                lv_obj_set_style_bg_opa(top_bar_, LV_OPA_50, 0);
+                lv_obj_move_to_index(top_bar_, top_bar_index_);
+            }
+            if (status_bar_ != nullptr) {
+                lv_obj_remove_flag(status_bar_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (lvgl_theme != nullptr) {
+                lv_obj_set_style_bg_color(lv_screen_active(), lvgl_theme->background_color(), 0);
+                if (container_ != nullptr) {
+                    lv_obj_set_style_bg_color(container_, lvgl_theme->background_color(), 0);
+                }
+            }
+            if (emoji_box_ != nullptr && preview_image_cached_ == nullptr) {
+                lv_obj_remove_flag(emoji_box_, LV_OBJ_FLAG_HIDDEN);
+            }
+            if (status_label_ != nullptr && standby_pending_status_.empty()) {
+                lv_obj_remove_flag(status_label_, LV_OBJ_FLAG_HIDDEN);
+            }
+        }
+        // 时间回到页面时立刻刷新，不等下一次整分钟
+        standby_clock_min_ = -1;
+        // 显隐切换后强制整屏重绘：只在隐藏标志上改，面板上会留着上一帧的字
+        // （真机见过「待命」两个字留在看板顶上）
+        lv_obj_invalidate(lv_screen_active());
+        lv_color_t box_bg = lv_obj_get_style_bg_color(standby_box_, LV_PART_MAIN);
+        lv_color_t ctr_bg = (container_ != nullptr)
+                                ? lv_obj_get_style_bg_color(container_, LV_PART_MAIN)
+                                : lv_color_black();
+        ESP_LOGI(TAG,
+                 "standby=%d box_hidden=%d status_hidden=%d box_bg=%02x%02x%02x/%d"
+                 " container_bg=%02x%02x%02x",
+                 static_cast<int>(visible),
+                 static_cast<int>(lv_obj_has_flag(standby_box_, LV_OBJ_FLAG_HIDDEN)),
+                 static_cast<int>(status_label_ != nullptr &&
+                                  lv_obj_has_flag(status_label_, LV_OBJ_FLAG_HIDDEN)),
+                 box_bg.red, box_bg.green, box_bg.blue,
+                 static_cast<int>(lv_obj_get_style_bg_opa(standby_box_, LV_PART_MAIN)),
+                 ctr_bg.red, ctr_bg.green, ctr_bg.blue);
+    }
+    if (visible) {
+        UpdateStandbyClock();
+    } else if (!standby_pending_status_.empty()) {
+        std::string pending = standby_pending_status_;
+        standby_pending_status_.clear();
+        LvglDisplay::SetStatus(pending.c_str());
+    }
+}
